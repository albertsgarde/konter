# Copy to ~/.config/systemd/user/ with konter-daily.service, then
#   systemctl --user enable --now konter-daily.timer
[Unit]
Description=konter's daily fetch and digest, early in the morning

[Timer]
OnCalendar=*-*-* 06:00
# Run at the next start if the server was off at 06:00.
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
